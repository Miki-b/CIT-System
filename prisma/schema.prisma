// CIT Delivery Tracking — Prisma schema
//
// The deployed prototype uses PostgreSQL because Vercel serverless functions
// do not provide a persistent project-local SQLite database. Enum-like fields
// are stored as strings and validated in the app layer via src/lib/domain.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String // ADMIN | DRIVER | CLIENT
  createdAt DateTime @default(now())
}

model Driver {
  id               String     @id @default(cuid())
  name             String
  phone            String
  status           String     @default("AVAILABLE") // AVAILABLE | ON_DELIVERY | OFFLINE
  currentLatitude  Float?
  currentLongitude Float?
  createdAt        DateTime   @default(now())
  deliveries       Delivery[]
}

model Client {
  id         String     @id @default(cuid())
  name       String
  company    String
  email      String     @unique
  phone      String
  createdAt  DateTime   @default(now())
  deliveries Delivery[]
}

model Delivery {
  id           String @id @default(cuid())
  trackingCode String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  pickupName      String
  pickupLatitude  Float
  pickupLongitude Float

  destinationName      String
  destinationLatitude  Float
  destinationLongitude Float

  status   String @default("CREATED") // see DeliveryStatus in src/lib/domain.ts
  priority String @default("STANDARD") // LOW | STANDARD | HIGH | CRITICAL

  currentLatitude  Float?
  currentLongitude Float?

  // Simulation progress along the route, 0..1 (prototype convenience field).
  progress Float @default(0)

  // Estimated arrival time.
  eta DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events DeliveryEvent[]

  @@index([status])
  @@index([driverId])
  @@index([clientId])
}

model DeliveryEvent {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  type      String // status change / info event type, see EventType in domain.ts
  message   String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  @@index([deliveryId])
}
