# ---------------------------------------------------------------------------
# CIT Delivery Tracking — Environment Variables
# Copy this file to ".env" and adjust as needed.
# ---------------------------------------------------------------------------

# Database connection.
# The prototype ships with SQLite for zero-config, reliable local setup.
# To use PostgreSQL instead, change the datasource provider in
# prisma/schema.prisma to "postgresql" and set a Postgres URL here, e.g.:
#   DATABASE_URL="postgresql://user:password@localhost:5432/cit?schema=public"
DATABASE_URL="file:./dev.db"

# Mapbox access token (public token, starts with "pk.").
# Get a free token at https://account.mapbox.com/access-tokens/
# OPTIONAL: If left blank, the app automatically renders a built-in
# high-fidelity fallback map so the live-tracking demo still works.
NEXT_PUBLIC_MAPBOX_TOKEN=
